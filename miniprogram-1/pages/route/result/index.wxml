<!--pages/route/result/index.wxml-->
<view class="container">
  <!-- 标题 -->
  <view class="header">
    <text class="from-to">{{plan.from}} → {{plan.to}}</text>
    <text class="pet-info">{{plan.petType}} · {{plan.breed}}</text>
  </view>

  <!-- 交通方案 -->
  <view class="card">
    <view class="card-title">🚗 交通方案</view>
    <view class="card-body">{{plan.transport}}</view>
  </view>

  <!-- 体检清单 -->
  <view class="card">
    <view class="card-title">💉 体检与证件清单</view>
    <view class="card-body">
      <text class="line" wx:for="{{plan.healthList}}" wx:key="index">{{item}}</text>
    </view>
  </view>

  <!-- 入住规范 -->
  <view class="card">
    <view class="card-title">🏠 目的地入住规范</view>
    <view class="card-body">{{plan.stay}}</view>
  </view>

  <!-- 沿途服务点 -->
  <view class="card">
    <view class="card-title">📍 沿途推荐服务点</view>
    <view class="card-body">{{plan.waypoints}}</view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn" bindtap="saveImage">保存为图片</button>
    <button class="btn primary" bindtap="goBack">返回修改</button>
  </view>
</view>