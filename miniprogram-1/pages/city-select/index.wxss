/* pages/city-select/index.wxss */
page {
  background: #f5f5f5;
}

/* 搜索框 */
.search-bar {
  padding: 12px 16px;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input {
  display: flex;
  align-items: center;
  background: #f0f0f0;
  border-radius: 20px;
  padding: 0 14px;
  height: 40px;
}

.search-icon {
  font-size: 16px;
  color: #999;
  margin-right: 8px;
}

.search-field {
  flex: 1;
  height: 100%;
  font-size: 15px;
  border: none;
  background: transparent;
}

.search-clear {
  font-size: 16px;
  color: #ccc;
  padding: 0 4px;
}

/* 城市列表 */
.city-list {
  height: calc(100vh - 80px);
  padding: 0 16px 20px;
}

.city-group {
  margin-bottom: 8px;
}

.group-title {
  font-size: 14px;
  font-weight: 600;
  color: #FF8C42;
  padding: 8px 0 4px;
  background: #f5f5f5;
}

.city-item {
  padding: 12px 16px;
  background: #fff;
  border-radius: 8px;
  margin-bottom: 2px;
  font-size: 15px;
  color: #333;
  transition: background 0.2s;
}

.city-item:active {
  background: #f0f0f0;
}

/* 右侧索引 */
.index-side {
  position: fixed;
  right: 6px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  z-index: 20;
}

.index-letter {
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #FF8C42;
  font-weight: 500;
  border-radius: 50%;
  transition: background 0.2s;
}

.index-letter:active {
  background: rgba(255, 140, 66, 0.2);
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 40px 0;
  color: #999;
  font-size: 15px;
}