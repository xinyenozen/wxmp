<!--pages/policy/compare/index.wxml-->
<view class="header">
  <view class="city-tags">
    <view class="city-tag" wx:for="{{selectedCities}}" wx:key="index">
      {{item}}
      <text class="remove" data-city="{{item}}" bindtap="removeCity">✕</text>
    </view>
    <view class="city-tag add" wx:if="{{selectedCities.length < 4}}" bindtap="showCityPicker">＋ 添加城市</view>
  </view>
  <view class="hint" wx:if="{{selectedCities.length < 2}}">请至少选择2个城市进行对比</view>
</view>

<!-- 表格区域保持不变，但去掉 wx:elif 条件，直接判断 selectedCities.length >= 2 即可 -->
<scroll-view class="table-wrapper" scroll-x="{{true}}" wx:if="{{selectedCities.length >= 2}}">
  <!-- 表头 -->
  <view class="row header-row">
    <view class="cell label-cell">对比项</view>
    <view class="cell city-cell" wx:for="{{cityPolicyList}}" wx:key="city">{{item.city}}</view>
  </view>

  <!-- 政策摘要 -->
  <view class="row">
    <view class="cell label-cell">政策概要</view>
    <view class="cell city-cell" wx:for="{{cityPolicyList}}" wx:key="city">{{item.policy.summary || '—'}}</view>
  </view>

  <!-- 禁养犬种 -->
  <view class="row">
    <view class="cell label-cell">禁养犬种</view>
    <view class="cell city-cell" wx:for="{{cityPolicyList}}" wx:key="city">
      <text class="breed-text">{{item.policy.bannedBreeds ? item.policy.bannedBreeds.slice(0,4).join('、') : '—'}}</text>
      <text wx:if="{{item.policy.bannedBreeds && item.policy.bannedBreeds.length > 4}}">等{{item.policy.bannedBreeds.length}}种</text>
    </view>
  </view>

  <!-- 限养区域 -->
  <view class="row">
    <view class="cell label-cell">限养/重点区域</view>
    <view class="cell city-cell" wx:for="{{cityPolicyList}}" wx:key="city">{{item.policy.restrictedAreas || '—'}}</view>
  </view>

  <!-- 登记费用 -->
  <view class="row">
    <view class="cell label-cell">登记费用</view>
    <view class="cell city-cell" wx:for="{{cityPolicyList}}" wx:key="city">{{item.policy.fee || '—'}}</view>
  </view>

  <!-- 处罚标准 -->
  <view class="row">
    <view class="cell label-cell">违规处罚</view>
    <view class="cell city-cell" wx:for="{{cityPolicyList}}" wx:key="city">{{item.policy.penalty || '—'}}</view>
  </view>
</scroll-view>

<!-- 空状态 -->
<view wx:else class="empty">
  <text class="empty-icon">📊</text>
  <text class="empty-text">添加2~4个城市，横向对比政策差异</text>
</view>

<!-- 底部按钮 -->
<view class="bottom-actions" wx:if="{{selectedCities.length >= 2}}">
  <button class="btn share" bindtap="shareCompare">分享对比结果</button>
  <button class="btn back" bindtap="goBack">返回政策页</button>
</view>