/* pages/policy/correct/index.wxss */
page {
  background: #f5f6fa;
  padding: 0;
  padding-top: 8px;
  padding-bottom: 30px;
}

.container {
  display: block;
  width: 100%;
  padding: 0 16px;
}

.field {
  background: #ffffff;
  border-radius: 14px;
  padding: 12px 14px;
  margin-bottom: 10px;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.05);
}

.label {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 10px;
}

.required {
  color: #e74c3c;
  margin-left: 4px;
}

.city-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 14px;
  background: #f0f2f5;
  border-radius: 10px;
}

.city-name {
  font-size: 15px;
  color: #1a1a1a;
}

.arrow {
  font-size: 18px;
  color: #bbb;
}

.options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.option {
  padding: 6px 14px;
  background: #f0f2f5;
  border-radius: 18px;
  font-size: 13px;
  color: #666;
  border: 2px solid transparent;
}

.option.active {
  background: #fff0e6;
  border-color: #ff8c42;
  color: #ff8c42;
  font-weight: 500;
}

.content-textarea {
  width: 100%;
  height: 100px;
  padding: 12px;
  background: #f0f2f5;
  border-radius: 10px;
  font-size: 15px;
  box-sizing: border-box;
  border: none;
  outline: none;
  resize: none;
}

.char-count {
  text-align: right;
  font-size: 12px;
  color: #bbb;
  margin-top: 4px;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.image-item {
  width: 72px;
  height: 72px;
  border-radius: 10px;
  overflow: hidden;
  position: relative;
  background: #f0f2f5;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: -6px;
  right: -6px;
  background: #e74c3c;
  color: #fff;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  text-align: center;
  line-height: 20px;
  font-size: 12px;
  font-weight: 600;
}

.image-upload {
  width: 72px;
  height: 72px;
  border: 2px dashed #ddd;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.upload-icon {
  font-size: 24px;
}

.upload-text {
  font-size: 11px;
  margin-top: 2px;
}

.image-hint {
  font-size: 12px;
  color: #bbb;
  margin-top: 8px;
}

/* ===== 输入框（联系方式）修改此处 ===== */
.input-field {
  width: 100%;
  padding: 14px 16px;           /* 增加上下内边距 */
  background: #f0f2f5;
  border-radius: 10px;
  font-size: 15px;
  box-sizing: border-box;
  border: none;
  outline: none;
  min-height: 50px;             /* 增加最小高度 */
}

.submit-area {
  margin-top: 4px;
}

.submit-btn {
  width: 100%;
  height: 48px;
  background: linear-gradient(135deg, #ff8c42, #ffa76d);
  color: #fff;
  border-radius: 24px;
  font-size: 17px;
  font-weight: 600;
  border: none;
  box-shadow: 0 3px 12px rgba(255, 140, 66, 0.3);
}

.submit-btn:active {
  opacity: 0.8;
  transform: scale(0.97);
}