/* pages/publish/index.wxss */
page {
  background: #f6f7fb;
  padding-bottom: 30px;
}

.tips-bar {
  background: #FFF4ED;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #FF8C42;
}

.tips-icon {
  font-size: 18px;
}

.form-section {
  background: #fff;
  margin: 12px 16px;
  padding: 16px;
  border-radius: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12px;
}

.required {
  color: #F44336;
  margin-left: 4px;
}

/* 类型选择 */
.type-grid {
  display: flex;
  gap: 12px;
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 0;
  background: #f5f5f5;
  border-radius: 12px;
  border: 2px solid transparent;
  transition: all 0.2s;
}

.type-item.active {
  background: #FFF4ED;
  border-color: #FF8C42;
}

.type-icon {
  font-size: 28px;
}

.type-label {
  font-size: 13px;
  color: #333;
  margin-top: 6px;
}

/* 位置选择 */
.location-box {
  display: flex;
  align-items: center;
  padding: 12px;
  background: #f8f9fa;
  border-radius: 12px;
  gap: 12px;
}

.location-icon {
  font-size: 24px;
}

.location-detail {
  flex: 1;
}

.location-name {
  font-size: 16px;
  font-weight: 500;
  color: #1a1a1a;
}

.location-address {
  font-size: 13px;
  color: #999;
  margin-top: 2px;
}

.location-arrow {
  font-size: 20px;
  color: #ccc;
}

.location-coords {
  margin-top: 8px;
  font-size: 12px;
  color: #aaa;
  display: flex;
  gap: 16px;
}

/* 文本域 */
.desc-textarea {
  width: 100%;
  height: 120px;
  padding: 12px;
  background: #f8f9fa;
  border-radius: 12px;
  font-size: 15px;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 12px;
  color: #ccc;
  margin-top: 4px;
}

/* 图片上传 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.image-item {
  width: 80px;
  height: 80px;
  border-radius: 12px;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: -6px;
  right: -6px;
  background: #F44336;
  color: #fff;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  text-align: center;
  line-height: 22px;
  font-size: 14px;
}

.image-upload {
  width: 80px;
  height: 80px;
  border: 2px dashed #ddd;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.upload-icon {
  font-size: 28px;
}

.upload-text {
  font-size: 12px;
  margin-top: 4px;
}

.image-hint {
  font-size: 12px;
  color: #ccc;
  margin-top: 8px;
}

/* 开关 */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-label {
  font-size: 15px;
  color: #333;
}

.switch-hint {
  font-size: 12px;
  color: #bbb;
  margin-top: 6px;
}

/* 提交按钮 */
.submit-area {
  padding: 0 16px;
  margin-top: 20px;
}

.submit-btn {
  width: 100%;
  height: 50px;
  background: linear-gradient(135deg, #FF8C42, #FFA76D);
  color: #fff;
  border-radius: 25px;
  font-size: 18px;
  font-weight: 600;
  border: none;
  box-shadow: 0 4px 16px rgba(255, 140, 66, 0.3);
}

.submit-btn:active {
  opacity: 0.8;
}