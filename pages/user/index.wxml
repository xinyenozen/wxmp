<!--pages/user/index.wxml-->
<!-- ==================== 用户信息卡片 ==================== -->
<!-- 用户信息卡片 -->
<view class="user-card">
  <view class="user-info">
    <view class="avatar-wrapper">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-placeholder">🐾</view>
    </view>
    <view class="user-detail">
      <view class="nickname">{{userInfo.nickName || '未登录'}}</view>
      <view class="user-level">
        <text class="level-tag">Lv.{{stats.level}}</text>
        <text class="level-title">{{levelTitle}}</text>
      </view>
    </view>
    <view class="edit-btn" bindtap="goToEditProfile">编辑</view>
  </view>

  <!-- 统计栏 -->
  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-number">{{stats.annotations}}</text>
      <text class="stat-label">标注数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">{{stats.score}}</text>
      <text class="stat-label">积分</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">{{stats.favorites}}</text>
      <text class="stat-label">收藏</text>
    </view>
  </view>
</view>

<!-- 功能菜单列表 -->
<view class="menu-section">
  <view class="menu-group">
    <view class="menu-item" bindtap="goToMyAnnotations">
      <view class="menu-left">
        <text class="menu-icon">📋</text>
        <text class="menu-title">我的标注</text>
      </view>
      <view class="menu-right">
        <text class="menu-badge" wx:if="{{stats.pendingCount > 0}}">{{stats.pendingCount}}条待审核</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToFavorites">
      <view class="menu-left">
        <text class="menu-icon">⭐</text>
        <text class="menu-title">我的收藏</text>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToMigrationKit">
      <view class="menu-left">
        <text class="menu-icon">🧳</text>
        <text class="menu-title">迁徙锦囊</text>
      </view>
      <view class="menu-right">
        <text class="menu-tag">已生成{{stats.migrationKits || 0}}份</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="goToMerchantApply">
      <view class="menu-left">
        <text class="menu-icon">🏪</text>
        <text class="menu-title">商家入驻</text>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToFeedback">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-title">意见反馈</text>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="goToAbout">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-title">关于安宠智图</text>
      </view>
      <view class="menu-right">
        <text class="menu-version">v1.0.0</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="handleLogout">
      <view class="menu-left">
        <text class="menu-icon">🚪</text>
        <text class="menu-title" style="color:#f44336;">退出登录</text>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>

<!-- 底部安全区 -->
<view class="footer-safe"></view>