/* pages/user/index.wxss */
/* ========== 全局重置 ========== */
page {
  background-color: #f6f7fb;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 用户信息卡片 ========== */
.user-card {
  margin: 16px 16px 0;
  background: linear-gradient(135deg, #FF8C42 0%, #FFA76D 100%);
  border-radius: 20px;
  padding: 24px 20px 16px;
  box-shadow: 0 8px 24px rgba(255, 140, 66, 0.3);
}

.user-info {
  display: flex;
  align-items: center;
  position: relative;
}

.avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
  background: #fff;
}

.user-detail {
  flex: 1;
  margin-left: 14px;
}

.nickname {
  font-size: 18px;
  font-weight: 600;
  color: #fff;
  line-height: 1.4;
}

.user-level {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
}

.level-tag {
  display: inline-block;
  padding: 1px 12px;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 12px;
  font-size: 11px;
  color: #fff;
  font-weight: 500;
}

.level-title {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
}

.edit-btn {
  padding: 4px 14px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16px;
  font-size: 12px;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.3);
}

/* ========== 统计栏 ========== */
.stats-bar {
  display: flex;
  align-items: center;
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 22px;
  font-weight: 700;
  color: #fff;
}

.stat-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 2px;
}

.stat-divider {
  width: 1px;
  height: 32px;
  background: rgba(255, 255, 255, 0.2);
}

/* ========== 功能菜单 ========== */
.menu-section {
  margin: 16px 16px 0;
}

.menu-group {
  background: #fff;
  border-radius: 16px;
  padding: 0 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
  min-height: 52px;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 14px;
}

.menu-icon {
  font-size: 22px;
  width: 28px;
  text-align: center;
}

.menu-title {
  font-size: 15px;
  color: #1a1a1a;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.menu-badge {
  font-size: 12px;
  color: #FF8C42;
  background: #fff4ed;
  padding: 2px 10px;
  border-radius: 12px;
}

.menu-tag {
  font-size: 12px;
  color: #999;
}

.menu-version {
  font-size: 12px;
  color: #bbb;
}

.menu-arrow {
  font-size: 18px;
  color: #ccc;
  font-weight: 300;
}

.menu-divider {
  height: 1px;
  background: #f0f0f0;
  margin: 0 -16px;
}

/* ========== 底部安全区 ========== */
.footer-safe {
  height: 20px;
}