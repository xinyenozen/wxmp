/* pages/login/index.wxss */
page {
  background: linear-gradient(135deg, #FF8C42 0%, #FFA76D 100%);
  height: 100%;
}
.logo-placeholder {
  width: 100px;
  height: 100px;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48px;
  color: #FF8C42;
  margin-bottom: 16px;
}
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 40px 32px;
  box-sizing: border-box;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60px;
}

.logo {
  width: 100px;
  height: 100px;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  margin-bottom: 16px;
}

.app-name {
  font-size: 28px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2px;
}

.app-slogan {
  font-size: 14px;
  color: rgba(255,255,255,0.85);
  margin-top: 8px;
  letter-spacing: 0.5px;
}

.login-area {
  width: 100%;
  max-width: 320px;
}

.login-btn {
  width: 100%;
  height: 52px;
  background: #fff;
  border-radius: 26px;
  border: none;
  font-size: 18px;
  font-weight: 600;
  color: #FF8C42;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  transition: all 0.2s;
  padding: 0 16px;
  line-height: 1;
  box-sizing: border-box;
  appearance: none;
  -webkit-appearance: none;
}

.login-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-icon {
  font-size: 22px;
  display: inline-block;
  line-height: 1;
}

.admin-trigger {
  margin-top: 20px;
  font-size: 13px;
  color: rgba(255,255,255,0.6);
  text-align: center;
  padding: 8px;
  border-bottom: 1px dashed rgba(255,255,255,0.2);
  display: block;
}

.admin-login {
  background: rgba(255,255,255,0.12);
  border-radius: 16px;
  padding: 24px 20px;
  backdrop-filter: blur(8px);
}

.admin-form {
  width: 100%;
}

.admin-input {
  width: 100%;
  height: 44px;
  background: rgba(255,255,255,0.9);
  border-radius: 10px;
  padding: 0 16px;
  font-size: 15px;
  color: #333;
  margin-bottom: 12px;
  box-sizing: border-box;
  border: none;
  outline: none;
}

.admin-btn {
  background: #fff;
  color: #FF8C42;
  margin-top: 4px;
}

.back-trigger {
  margin-top: 16px;
  font-size: 13px;
  color: rgba(255,255,255,0.7);
  text-align: center;
  padding: 4px;
}

.footer {
  position: absolute;
  bottom: 30px;
  font-size: 12px;
  color: rgba(255,255,255,0.4);
}