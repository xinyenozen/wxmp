/* pages/annotations/index.wxss */
page {
  background: #f5f6fa;
  padding-bottom: 20px;
}

.container {
  padding: 12px 8px 0;
}

.stats {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 14px;
  padding: 14px 8px;
  margin-bottom: 14px;
  box-shadow: 0 1px 6px rgba(0,0,0,0.04);
}

.stat-item {
  font-size: 14px;
  color: #666;
  letter-spacing: 0.3px;
}
.stat-item.pending { color: #ff9800; }
.stat-item.passed { color: #4caf50; }
.stat-item.rejected { color: #f44336; }

.list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.item {
  background: #fff;
  border-radius: 16px;
  padding: 16px 16px;   /* 减少左右内边距 */
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  transition: all 0.2s;
}
.item:active {
  transform: scale(0.98);
  background: #f8f8f8;
}

.item-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
}

.type-icon {
  font-size: 20px;
  flex-shrink: 0;
}

.item-title {
  flex: 1;
  font-size: 16px;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.3px;
}

.status {
  font-size: 12px;
  padding: 2px 12px;
  border-radius: 14px;
  font-weight: 500;
  flex-shrink: 0;
}
.status.pending {
  background: #fff3e0;
  color: #ff9800;
}
.status.passed {
  background: #e8f5e9;
  color: #4caf50;
}
.status.rejected {
  background: #ffebee;
  color: #f44336;
}

.item-address {
  font-size: 14px;
  color: #666;
  margin-bottom: 2px;
  letter-spacing: 0.2px;
}

.item-desc {
  font-size: 14px;
  color: #444;
  line-height: 1.5;
  letter-spacing: 0.2px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8px;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: #bbb;
  padding-top: 6px;
  border-top: 1px solid #f0f0f0;
}

.item-type {
  background: #f0f0f0;
  padding: 2px 12px;
  border-radius: 12px;
  color: #666;
  font-size: 12px;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
}
.empty-icon {
  font-size: 64px;
}
.empty-text {
  font-size: 18px;
  color: #333;
  margin-top: 16px;
}
.empty-hint {
  font-size: 14px;
  color: #bbb;
  margin-top: 8px;
}
.empty-btn {
  margin-top: 20px;
  background: #FF8C42;
  color: #fff;
  border-radius: 24px;
  padding: 10px 40px;
  border: none;
  font-size: 16px;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.mask.show {
  opacity: 1;
  visibility: visible;
}

.modal {
  background: #fff;
  border-radius: 20px;
  width: 100%;
  max-width: 400px;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: scale(0.9);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}
.mask.show .modal {
  transform: scale(1);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #f0f0f0;
}
.modal-title {
  font-size: 18px;
  font-weight: 600;
  color: #1a1a1a;
}
.modal-close {
  font-size: 22px;
  color: #999;
}

.modal-body {
  padding: 20px;
  overflow-y: auto;
  flex: 1;
}
.modal-row {
  margin-bottom: 10px;
  font-size: 15px;
  color: #333;
  line-height: 1.6;
}
.modal-label {
  font-weight: 500;
  color: #888;
}
.modal-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 4px;
  gap: 6px;
}
.modal-images image {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  background: #f0f0f0;
}

.modal-footer {
  padding: 12px 20px 20px;
  border-top: 1px solid #f0f0f0;
}
.modal-btn {
  width: 100%;
  height: 44px;
  background: #FF8C42;
  color: #fff;
  border-radius: 22px;
  border: none;
  font-size: 16px;
}