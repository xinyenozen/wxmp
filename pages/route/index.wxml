<!--pages/route/index.wxml-->
<!-- 表单页 -->
<!-- 表单卡片 -->
<view class="form-card">
  <!-- 起点城市 -->
  <view class="field">
    <text class="label">🚀 出发城市</text>
    <view class="city-selector" bindtap="selectStartCity">
      <text class="city-name">{{startCity || '请选择'}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 终点城市 -->
  <view class="field">
    <text class="label">📍 目的城市</text>
    <view class="city-selector" bindtap="selectEndCity">
      <text class="city-name">{{endCity || '请选择'}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 宠物类型 -->
  <view class="field">
    <text class="label">🐾 宠物类型</text>
    <view class="options">
      <view class="option {{petType === '狗' ? 'active' : ''}}" bindtap="selectPetType" data-type="狗">🐕 狗</view>
      <view class="option {{petType === '猫' ? 'active' : ''}}" bindtap="selectPetType" data-type="猫">🐈 猫</view>
    </view>
  </view>

  <!-- 品种 -->
  <view class="field" wx:if="{{petType}}">
    <text class="label">品种</text>
    <picker mode="selector" range="{{breedList}}" bindchange="onBreedChange">
      <view class="picker-value">{{breed || '请选择'}}</view>
    </picker>
  </view>
</view>

<!-- 生成按钮 -->
<view class="submit-area">
  <button class="submit-btn" bindtap="generateRoute">生成迁徙方案</button>
</view>