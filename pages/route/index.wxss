/* pages/route/index.wxss */
page {
  background: #f6f7fb;
  padding: 16px;
  padding-bottom: 80px;
}

.form-card {
  background: #fff;
  border-radius: 16px;
  padding: 20px 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.field {
  margin-bottom: 20px;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 14px;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8px;
}

.city-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: #f5f5f5;
  border-radius: 10px;
}

.city-name {
  font-size: 16px;
  color: #1a1a1a;
}

.arrow {
  font-size: 20px;
  color: #bbb;
}

.options {
  display: flex;
  gap: 12px;
}

.option {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  background: #f5f5f5;
  border-radius: 10px;
  font-size: 15px;
  color: #666;
  border: 2px solid transparent;
  transition: all 0.2s;
}

.option.active {
  background: #FFF4ED;
  border-color: #FF8C42;
  color: #FF8C42;
  font-weight: 500;
}

.picker-value {
  padding: 12px 16px;
  background: #f5f5f5;
  border-radius: 10px;
  font-size: 15px;
  color: #1a1a1a;
}

.submit-area {
  margin-top: 24px;
}

.submit-btn {
  width: 100%;
  height: 50px;
  background: linear-gradient(135deg, #FF8C42, #FFA76D);
  color: #fff;
  border-radius: 25px;
  font-size: 18px;
  font-weight: 600;
  border: none;
  box-shadow: 0 4px 16px rgba(255, 140, 66, 0.3);
}

.submit-btn:active {
  opacity: 0.8;
}